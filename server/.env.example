DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_DATABASE=app_starter
JWT_SECRET=change_me_to_a_long_secure_value

# SMSOnlineGH: server-only credentials. Sending is OFF until enabled in Configuration.
SMS_API_HOST=api.smsonlinegh.com
SMS_API_KEY=
SMS_SENDER_ID=
# HTTPS by default. Set http only deliberately if required by your provider (unencrypted).
SMS_API_PROTOCOL=https

# Paystack: server-only. sk_live_ keys collect real money; use your own sk_test_ key for a sandbox.
# Test transactions are recorded separately and never credit real customer balances.
PAYSTACK_SECRET_KEY=
